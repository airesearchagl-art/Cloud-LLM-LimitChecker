APP_DB_URL=sqlite:///./limit_checker.db
APP_TIMEZONE=Asia/Tokyo

# Keep this false outside local initialization/maintenance.
ENABLE_SEED_API=false

# Vendor collectors are disabled by default. Collectors must only call usage,
# costs, billing, quota, or rate-limit management APIs.
ENABLE_VENDOR_COLLECTORS=false
ENABLE_OPENAI_COLLECTOR=false
ENABLE_GEMINI_COLLECTOR=false
ENABLE_CLAUDE_COLLECTOR=false
COLLECTOR_DRY_RUN_DEFAULT=true
ALLOW_PAID_MODEL_CALLS=false
MAX_COLLECTOR_CALLS_PER_DAY=24

# Keep this false for single-machine local use. Set true before LAN/NAS sharing.
ENABLE_BASIC_AUTH=false
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Store secrets only in environment variables. Do not save raw API keys in SQLite.
# See docs/vendor-collector-production-readiness.md for the official-docs
# evidence behind each vendor's auth requirements below.

# Must be an Organization Admin API key (Organization -> Admin keys), not a
# regular/project API key -- the Usage and Costs management endpoints reject
# a regular key.
OPENAI_API_KEY=

# GEMINI_API_KEY alone is NOT sufficient and is not used by the management
# collector: Cloud Monitoring and Service Usage/Consumer Quota APIs require
# OAuth2/Application Default Credentials, never an API key (confirmed via
# official Google Cloud docs). Set GOOGLE_CLOUD_ACCESS_TOKEN and
# GOOGLE_CLOUD_PROJECT (or GEMINI_PROJECT_ID) instead to enable the Gemini
# collector. GEMINI_API_KEY is listed here only because it may already be set
# for unrelated local tooling; this app never reads it for collection.
GEMINI_API_KEY=

# GOOGLE_CLOUD_ACCESS_TOKEN is used as a static OAuth2 bearer token only --
# this app does NOT implement Application Default Credentials discovery or
# token refresh. You must obtain and refresh the token yourself (e.g. via
# `gcloud auth print-access-token`) and keep it current in this file/your
# environment. Full ADC support is a future candidate, not implemented here.
GOOGLE_CLOUD_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
GEMINI_PROJECT_ID=

# Must be an organization Admin API key (prefix sk-ant-admin01-), not a
# regular API key -- the Usage and Cost Admin API endpoints reject a regular
# key. Organization/workspace scoping is optional and only used to group
# imported records; it does not change what the Admin key can read.
ANTHROPIC_API_KEY=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_WORKSPACE_ID=
